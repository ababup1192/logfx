#!/usr/bin/env bash
# Takes a named exclusive lock, then runs the command.
#
# WhyNot: not flock, which macOS does not ship (it is util-linux). shlock is BSD standard and looks
# at whether the PID in the lock file is alive, so it reclaims a lock left behind by a -9 on its own.
# WhyNot: the waiting is not written at the call site. Waiting with pgrep matches the waiter's own
# command line and waits forever (this actually happened, and pkill took other work down with it).
set -u

name="$1"
shift

lock="${TMPDIR:-/tmp}/flix.${name}.lock"
waited=0
limit="${WITH_LOCK_TIMEOUT:-3600}"

until /usr/bin/shlock -f "$lock" -p $$; do
    if [ "$waited" -eq 0 ]; then
        echo "with-lock: ${name} is in use. Waiting for it (${lock})" >&2
    fi
    sleep 2
    waited=$((waited + 2))
    if [ "$waited" -ge "$limit" ]; then
        echo "with-lock: ${name} did not free up in ${limit}s. Check ${lock}" >&2
        exit 124
    fi
done

# WhyNot: no trap to remove the lock. exec hands the PID over, so the PID in the lock file points at
# the process that is actually running. When it ends the PID dies, and the next waiter's shlock reclaims it.
exec "$@"
