#!/usr/bin/env bash
# A flix wrapper. The compiler jar is borrowed from a devbox profile.
# WhyNot: the flix command from flix.nix is not exec'd directly, because it ships its own JRE at a
# different minor version than the local jdk. Only the jar is borrowed; the JRE stays the local one.
ENGINE_ROOT="${FLIX_ENGINE_ROOT:-$HOME/Desktop/flix_game_engine}"

# To point at a jar directly (CI, for one), pass FLIX_JAR in the environment (the release flix.jar)
FLIX_JAR="${FLIX_JAR:-}"
if [ -n "$FLIX_JAR" ] && [ ! -f "$FLIX_JAR" ]; then FLIX_JAR=""; fi
real="$(readlink -f "$ENGINE_ROOT/.devbox/nix/profile/default/bin/flix" 2>/dev/null)"
if [ -z "$FLIX_JAR" ]; then
    case "$real" in
        /nix/store/*)
            jar="$(dirname "$(dirname "$real")")/share/java/flix/flix.jar"
            if [ -f "$jar" ]; then FLIX_JAR="$jar"; fi
            ;;
    esac
fi

if [ -z "$FLIX_JAR" ]; then
    echo "flix.jar not found. Create the devbox profile in $ENGINE_ROOT." >&2
    exit 127
fi

JAVA_CMD="java"
if ! java -version >/dev/null 2>&1; then
    JAVA_CMD="$ENGINE_ROOT/.devbox/nix/profile/default/bin/java"
fi
if ! "$JAVA_CMD" -version >/dev/null 2>&1; then
    echo "java not found. Put a JDK on the PATH." >&2
    exit 127
fi

# WhyNot: --Xsubeffecting=lambdas is not passed. The calling side builds with a plain flix, so code
# that only compiles with this flag ships as a version that is green here and impossible to install.
# Where a pure lambda goes into a `\ IO` position, write checked_ecast instead.
# WhyNot: a github: dependency is not resolved unauthenticated. CI runners share IPs and hit the
# unauthenticated API limit quickly, which fails the build during dependency resolution.
if [ -n "${GITHUB_TOKEN:-}" ]; then
    exec "$JAVA_CMD" -Xss32m -jar "$FLIX_JAR" "$@" --github-token "$GITHUB_TOKEN"
fi

exec "$JAVA_CMD" -Xss32m -jar "$FLIX_JAR" "$@"
